<Window x:Class="JvtechCyber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Diagnostic Cyber" Height="820" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <DockPanel>
        <!-- En-tête : note de l'entreprise et menaces -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ScoreCircle" Width="96" Height="96" CornerRadius="20" Background="{StaticResource InfoBrush}">
                    <TextBlock x:Name="ScoreText" Text="0" Foreground="White" FontSize="44" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource HeaderTextBrush}" FontSize="12" FontWeight="SemiBold">
                        <Run Text="JVTECH · DIAGNOSTIC CYBER DE L'ENTREPRISE"/>
                        <Hyperlink x:Name="UpdateLink" Foreground="{StaticResource UpdateBrush}" Click="UpdateLink_Click"><Run x:Name="UpdateText"/></Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="GradeText" Text="Nouveau diagnostic" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock x:Name="CompareText" Foreground="{StaticResource HeaderMutedBrush}" Margin="0,4,0,0"/>
                    <WrapPanel x:Name="ThreatPanel" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre d'actions -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dossier des diagnostics" Click="OpenFolder_Click"/>
                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Rapport PDF" Margin="0,0,8,0" Click="Report_Click"
                            ToolTip="Note, menaces, état par thème et plan d'action chiffré, avec ton logo"/>
                    <Button Content="Enregistrer" Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="Importer les postes (PC Sécurité)…" Margin="0,0,8,0" Click="Import_Click"
                            ToolTip="Fichiers .jvsec créés par PC Sécurité sur chaque poste (bouton « Pour le diagnostic cyber »)"/>
                    <Button Content="Mes tarifs" Click="Tarifs_Click" ToolTip="Prix des prestations JVTECH affichés dans le plan d'action"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Entreprises déjà diagnostiquées -->
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Entreprises" Style="{StaticResource SectionTitle}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="+  Nouvelle entreprise" Click="NewCompany_Click" Margin="0,0,0,6"/>
                        <Button x:Name="RedoButton" Content="Refaire le diagnostic aujourd'hui" Click="Redo_Click" IsEnabled="False"
                                ToolTip="Repart du dernier diagnostic de l'entreprise, à la date du jour, pour suivre la progression"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="HistoryText" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"/>
                    <ListBox x:Name="CompanyList" BorderThickness="0" SelectionChanged="CompanyList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,18" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Entreprise" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBox x:Name="CompanyBox" Grid.Column="1" Margin="0,4,16,4" TextChanged="Field_Changed"/>
                            <TextBlock Grid.Column="2" Text="Interlocuteur" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBox x:Name="ContactBox" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Activité" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBox x:Name="ActivityBox" Grid.Row="1" Grid.Column="1" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Nombre de postes" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBox x:Name="WorkstationsBox" Grid.Row="1" Grid.Column="3" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Date" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <DatePicker x:Name="DateBox" Grid.Row="2" Grid.Column="1" Margin="0,4,16,4" HorizontalAlignment="Left" Width="160"/>
                            <TextBlock x:Name="PostesText" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                       Style="{StaticResource Hint}" Text="Aucun poste importé depuis PC Sécurité."/>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,10"
                               Text="Pour chaque thème, cocher la situation qui décrit le mieux l'entreprise aujourd'hui. Les constats des postes importés apparaissent en bleu."/>

                    <!-- Un bloc par thème, construit depuis le référentiel -->
                    <StackPanel x:Name="ThemePanel"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Remarques générales" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="NotesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
