<Window x:Class="JvtechAtelier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Atelier" Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Carte d'étape cliquable -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PcTitle" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock x:Name="FolderText" Style="{StaticResource AppSubtitle}" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="JVTECH ATELIER" Style="{StaticResource AppName}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Les 6 étapes du parcours (cahier § 3.2) -->
        <ItemsControl x:Name="Steps" DockPanel.Dock="Top" Margin="24,16,16,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource StepButton}" Tag="{Binding Index}" Click="Step_Click" IsEnabled="{Binding Enabled}"
                            BorderBrush="{Binding Border}" BorderThickness="{Binding Thickness}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding State}" Style="{StaticResource CardDetail}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Étape 1 : identification -->
            <Border x:Name="IdentPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Identification du PC" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Valeurs lues sur le PC. Corriger dans la colonne « Valeur retenue » : la valeur détectée reste gardée dans le dossier et la fiche interne. Ce qui n'est pas lu reste « Non détecté »."/>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="N° d'inventaire (V…)" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="InventoryBox" Width="140" Margin="0,2,0,0" ToolTip="Numéro VENTE NANTERRE, par exemple V1042. Laisser vide s'il n'est pas encore attribué."/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Technicien" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="OperatorBox" Width="160" Margin="0,2,0,0" ToolTip="Nom noté à côté de chaque correction et de chaque test (réglable dans atelier.ini : Technicien=)"/>
                        </StackPanel>
                        <Button x:Name="ReloadButton" Content="Relire le PC" Margin="0,16,8,0" Click="Reload_Click"/>
                        <Button x:Name="SaveButton" Content="Enregistrer le dossier" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Save_Click"/>
                    </WrapPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                    <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              BorderBrush="{StaticResource BorderBrush}" Background="White" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Information" Binding="{Binding Nom}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Détecté" Binding="{Binding Detecte}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Valeur retenue (modifiable)" Binding="{Binding Retenu, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Étape 2 : préparation (seule étape qui modifie Windows, sauf Sysprep) -->
            <Border x:Name="PrepPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" x:Name="StopPrepButton" Content="Arrêter après l'action en cours" IsEnabled="False" Click="StopPrep_Click"/>
                        <TextBlock Text="Préparation" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,8"
                               Text="N'efface rien et ne lance pas Sysprep. Chaque action est notée dans le journal du dossier : état avant, état après, code retour, durée. Brancher le chargeur et laisser la clé USB en place."/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="PrepStatus" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mises à jour Windows" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdateState" Style="{StaticResource CardDetail}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,4">
                                <Button x:Name="UpdateButton" Content="Lancer une passe Windows Update" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RunUpdates_Click"/>
                                <Button x:Name="RebootButton" Content="Redémarrer et reprendre" Visibility="Collapsed" Click="Reboot_Click"
                                        ToolTip="Atelier se relance à l'ouverture de session (clé USB branchée) et fait la passe suivante."/>
                            </WrapPanel>

                            <TextBlock Text="Logiciels" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <ItemsControl x:Name="SoftwareList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nom}" IsChecked="{Binding Coche, Mode=TwoWay}" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="SoftwareButton" Content="Installer les logiciels cochés (winget)" HorizontalAlignment="Left" Margin="0,6,0,0" Click="InstallSoftware_Click"/>

                            <TextBlock Text="Pilotes" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <TextBlock x:Name="DriversState" Style="{StaticResource CardDetail}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Les pilotes proposés par Windows Update sont installés avec les mises à jour. Relire ensuite les périphériques en erreur."/>
                            <WrapPanel>
                                <Button x:Name="DriversButton" Content="Relire les périphériques" Margin="0,0,8,0" Click="ReadDrivers_Click"/>
                                <Button Content="Ouvrir le Gestionnaire de périphériques" Style="{StaticResource LinkButton}" Click="OpenDeviceManager_Click"/>
                            </WrapPanel>

                            <TextBlock Text="Mémoire : diagnostic approfondi" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource CardDetail}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Outil de Windows, avec redémarrage (choisi dans sa fenêtre). Le résultat est relu dans « Contrôles et tests ». Distinct du contrôle rapide, qui ne garantit pas l'absence de défaut."/>
                            <Button x:Name="MemoryButton" Content="Ouvrir le diagnostic mémoire de Windows" HorizontalAlignment="Left" Click="RunMemoryDiagnostic_Click"/>

                            <TextBlock Text="Accepter en l'état" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource CardDetail}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Si une mise à jour reste en échec ou si un logiciel ne s'installe pas : le noter ici, avec une raison. Le nom du technicien et l'heure sont gardés dans le dossier."/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Accepter la préparation en l'état" Margin="8,0,0,0" Click="AcceptPrep_Click"/>
                                <TextBox x:Name="AcceptReason" ToolTip="Raison (ex. : KB5034441 en échec connu, sans effet sur l'usage)"/>
                            </DockPanel>

                            <TextBlock Text="Actions de cette session" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
                            <ItemsControl x:Name="PrepActions">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Background="{Binding PillBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top" Width="120">
                                                <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PillForeground}" TextAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Constat}" Style="{StaticResource CardDetail}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Étape 3 : tests -->
            <Border x:Name="TestsPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" x:Name="RunChecksButton" Content="Lancer les contrôles" Style="{StaticResource PrimaryButton}" Click="RunChecks_Click"/>
                        <TextBlock Text="Contrôles et tests" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="TestsStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Contrôles automatiques (lecture seule)" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="AutoChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Background="{Binding PillBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top" Width="120">
                                                <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PillForeground}" TextAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Constat}" Style="{StaticResource CardDetail}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="Ouvrir les tests écran, clavier, son, micro, webcam" Style="{StaticResource LinkButton}" Click="OpenPeripheralTest_Click"/>
                                <TextBlock Text="Tests manuels" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Chaque résultat est enregistré dans le dossier du PC avec le nom du technicien et l'heure. En cas d'échec, choisir s'il bloque la vente ou s'il devient une réserve écrite dans l'annonce."/>
                            <ItemsControl x:Name="ManualTests">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Libelle}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ResultatIndex, Mode=TwoWay}" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Non testé"/>
                                                <ComboBoxItem Content="Réussi"/>
                                                <ComboBoxItem Content="Échec"/>
                                                <ComboBoxItem Content="Non applicable"/>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" SelectedIndex="{Binding PorteeIndex, Mode=TwoWay}" IsEnabled="{Binding EstEchec}" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Bloque la vente"/>
                                                <ComboBoxItem Content="Réserve commerciale"/>
                                            </ComboBox>
                                            <TextBox Grid.Column="3" Text="{Binding Remarque, UpdateSourceTrigger=PropertyChanged}" ToolTip="Remarque (touche usée, rayure sur le capot…)"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Enregistrer les tests" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveTests_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Étapes 4 et 5 : fiche et annonce -->
            <Border x:Name="ListingPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Fiche et annonce" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="Texte composé à partir des valeurs retenues (corrigées comprises) et des tests. Ce qui n'est pas connu n'est pas écrit. Les réserves commerciales sont toujours mentionnées. Pas de lien ni de prix."/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="État" Style="{StaticResource CardTitle}"/>
                            <ComboBox x:Name="ConditionBox" Width="200" IsEditable="True" Margin="0,2,0,0">
                                <ComboBoxItem Content="Très bon état"/>
                                <ComboBoxItem Content="Bon état"/>
                                <ComboBoxItem Content="État correct, traces d'usage"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Remarques (ajoutées à la fin)" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="NotesBox" Width="320" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="Composer le texte" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Compose_Click"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ListingWarnings" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" x:Name="TitleLength" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="ListingTitle" TextChanged="ListingTitle_Changed" FontWeight="SemiBold"/>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Copier le titre" Margin="0,0,8,0" Click="CopyTitle_Click"/>
                        <Button Content="Copier le descriptif" Margin="0,0,8,0" Click="CopyDescription_Click"/>
                        <Button Content="Enregistrer fiches et annonce dans le dossier" Style="{StaticResource PrimaryButton}" Click="SaveListing_Click"/>
                        <TextBlock x:Name="ListingStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <TextBox x:Name="ListingText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>
                </DockPanel>
            </Border>

            <!-- Étapes pas encore disponibles -->
            <Border x:Name="LaterPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LaterTitle" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Cette étape arrive dans une prochaine version du lot 1."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border x:Name="SaleCard" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="STATUT AVANT VENTE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="SaleStatus" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="SaleDetail" Style="{StaticResource CardDetail}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="FINALISATION" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="FinalizeText" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
