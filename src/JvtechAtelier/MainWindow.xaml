<Window x:Class="JvtechAtelier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Atelier" Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Carte d'étape cliquable -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PcTitle" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock x:Name="FolderText" Style="{StaticResource AppSubtitle}" TextAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="JVTECH ATELIER" Style="{StaticResource AppName}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Les 6 étapes du parcours (cahier § 3.2) -->
        <ItemsControl x:Name="Steps" DockPanel.Dock="Top" Margin="24,16,16,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource StepButton}" Tag="{Binding Index}" Click="Step_Click" IsEnabled="{Binding Enabled}"
                            BorderBrush="{Binding Border}" BorderThickness="{Binding Thickness}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding State}" Style="{StaticResource CardDetail}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="24,16,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Étape 1 : identification -->
            <Border x:Name="IdentPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Identification du PC" Style="{StaticResource PageTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Valeurs lues sur le PC. Corriger dans la colonne « Valeur retenue » : la valeur détectée reste gardée dans le dossier et la fiche interne. Ce qui n'est pas lu reste « Non détecté »."/>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="N° d'inventaire (V…)" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="InventoryBox" Width="140" Margin="0,2,0,0" ToolTip="Numéro VENTE NANTERRE, par exemple V1042. Laisser vide s'il n'est pas encore attribué."/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Technicien" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="OperatorBox" Width="160" Margin="0,2,0,0" ToolTip="Nom noté à côté de chaque correction et de chaque test (réglable dans atelier.ini : Technicien=)"/>
                        </StackPanel>
                        <Button x:Name="ReloadButton" Content="Relire le PC" Margin="0,16,8,0" Click="Reload_Click"/>
                        <Button x:Name="SaveButton" Content="Enregistrer le dossier" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="Save_Click"/>
                    </WrapPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                    <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              BorderBrush="{StaticResource BorderBrush}" Background="White" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Information" Binding="{Binding Nom}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Détecté" Binding="{Binding Detecte}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Valeur retenue (modifiable)" Binding="{Binding Retenu, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Étape 3 : tests -->
            <Border x:Name="TestsPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" x:Name="RunChecksButton" Content="Lancer les contrôles" Style="{StaticResource PrimaryButton}" Click="RunChecks_Click"/>
                        <TextBlock Text="Contrôles et tests" Style="{StaticResource PageTitle}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="TestsStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Contrôles automatiques (lecture seule)" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="AutoChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Background="{Binding PillBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top" Width="120">
                                                <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding PillForeground}" TextAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Constat}" Style="{StaticResource CardDetail}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="Ouvrir les tests écran, clavier, son, micro, webcam" Style="{StaticResource LinkButton}" Click="OpenPeripheralTest_Click"/>
                                <TextBlock Text="Tests manuels" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Chaque résultat est enregistré dans le dossier du PC avec le nom du technicien et l'heure. En cas d'échec, choisir s'il bloque la vente ou s'il devient une réserve écrite dans l'annonce."/>
                            <ItemsControl x:Name="ManualTests">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Libelle}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ResultatIndex, Mode=TwoWay}" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Non testé"/>
                                                <ComboBoxItem Content="Réussi"/>
                                                <ComboBoxItem Content="Échec"/>
                                                <ComboBoxItem Content="Non applicable"/>
                                            </ComboBox>
                                            <ComboBox Grid.Column="2" SelectedIndex="{Binding PorteeIndex, Mode=TwoWay}" IsEnabled="{Binding EstEchec}" Margin="0,0,6,0">
                                                <ComboBoxItem Content="Bloque la vente"/>
                                                <ComboBoxItem Content="Réserve commerciale"/>
                                            </ComboBox>
                                            <TextBox Grid.Column="3" Text="{Binding Remarque, UpdateSourceTrigger=PropertyChanged}" ToolTip="Remarque (touche usée, rayure sur le capot…)"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Enregistrer les tests" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveTests_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Étapes pas encore disponibles -->
            <Border x:Name="LaterPanel" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LaterTitle" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Cette étape arrive dans une prochaine version du lot 1."/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border x:Name="SaleCard" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="STATUT AVANT VENTE" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="SaleStatus" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="SaleDetail" Style="{StaticResource CardDetail}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="FINALISATION" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="FinalizeText" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
