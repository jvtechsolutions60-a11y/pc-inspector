<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JVTECH Atelier : préparation des PC d'achat-revente, après une installation de Windows 11 par clé USB.
    Un seul .exe : la bibliothèque commune (JvtechLecture) et les actions (JvtechAtelier.Actions) sont compilées dedans.
    Seul logiciel v2 à inclure JvtechAtelier.Actions, le seul code autorisé à modifier Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>JvtechAtelier</AssemblyName>
    <RootNamespace>JvtechAtelier</RootNamespace>
    <Product>JVTECH Atelier</Product>
    <Company>JVTECH Solutions</Company>
    <Version>2.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Lot 0 : sans droits administrateur. Ils seront demandés à l'étape qui en a besoin (lot 1). -->
    <ApplicationManifest>..\JvtechAudit\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PcInspector\Polyfills.cs" Link="Shared\Polyfills.cs" />
    <Compile Include="..\PcInspector\Collectors\Wmi.cs" Link="Shared\Wmi.cs" />
    <Page Include="..\PcInspector\Theme.xaml" Link="Theme.xaml" />
    <Compile Include="..\PcInspector\AppInfo.cs" Link="Shared\AppInfo.cs" />
    <Compile Include="..\PcInspector\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
    <Compile Include="..\JvtechLecture\**\*.cs" Exclude="..\JvtechLecture\obj\**;..\JvtechLecture\bin\**" LinkBase="Lecture" />
    <Compile Include="..\JvtechAtelier.Actions\**\*.cs" Exclude="..\JvtechAtelier.Actions\obj\**;..\JvtechAtelier.Actions\bin\**" LinkBase="Actions" />
  </ItemGroup>

</Project>
