<Window x:Class="PcMigration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Migration" Height="820" Width="1140" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- En-tête, comme les autres logiciels JVTECH -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ComputerText" Foreground="{StaticResource HeaderMutedBrush}" VerticalAlignment="Center"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PC MIGRATION" Style="{StaticResource AppName}"/>
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                        <Border x:Name="PortableText" Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="Lancé depuis une clé USB : réglages et rapports sont enregistrés sur la clé.">
                            <TextBlock Text="Mode clé USB" Foreground="White" FontSize="11"/>
                        </Border>
                        <TextBlock x:Name="UpdateArea" VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12" Visibility="Collapsed">
                            <Hyperlink x:Name="UpdateLink" Foreground="{StaticResource UpdateBrush}" Click="UpdateLink_Click"><Run x:Name="UpdateText"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Ancien PC → disque externe → nouveau PC : dossiers, navigateurs, mots de passe, applications, Wi-Fi, Outlook" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="22,16,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="Tabs" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
                <!-- ===== Sauvegarde ===== -->
                <TabItem Header="  1. Sauvegarder l'ancien PC  " FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontSize="13">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Compte et client" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Compte Windows du client" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="BackupProfileCombo" Grid.Column="1" SelectionChanged="BackupProfileCombo_SelectionChanged"/>
                                        <TextBlock Grid.Row="1" Text="Client" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox x:Name="ClientBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="4,3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Disque de destination" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Autre dossier…" Margin="8,0,0,0" Padding="10,3" Click="BrowseDestination_Click"/>
                                        <Button DockPanel.Dock="Right" Content="⟳" Margin="8,0,0,0" Padding="10,3" Click="RefreshDrives_Click" ToolTip="Disque branché après l'ouverture"/>
                                        <ComboBox x:Name="DriveCombo" SelectionChanged="DriveCombo_SelectionChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DestInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="À sauvegarder" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel x:Name="BackupItems"/>
                                    <TextBlock x:Name="BackupTotal" Style="{StaticResource Hint}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Mot de passe de la sauvegarde" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                               Text="Obligatoire pour les mots de passe et le Wi-Fi : ils sont chiffrés avec lui sur le disque (AES-256). À redonner sur le nouveau PC. Les documents, eux, ne sont pas chiffrés : garder le disque en lieu sûr."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Mot de passe" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="BackupPassword" Grid.Column="1" Padding="4,3"/>
                                        <TextBlock Grid.Row="1" Text="Confirmation" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <PasswordBox x:Name="BackupPassword2" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="4,3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="▶  Lancer la sauvegarde" Padding="14,9"
                                    HorizontalAlignment="Left" Click="BackupButton_Click" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Restauration ===== -->
                <TabItem Header="  2. Restaurer sur le nouveau PC  " FontSize="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" FontSize="13">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Sauvegarde à restaurer" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Autre dossier…" Margin="8,0,0,0" Padding="10,3" Click="BrowseSource_Click"/>
                                        <Button DockPanel.Dock="Right" Content="⟳" Margin="8,0,0,0" Padding="10,3" Click="RefreshSources_Click" ToolTip="Disque branché après l'ouverture"/>
                                        <ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="SourceInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Compte Windows du client sur ce PC" Style="{StaticResource SectionTitle}"/>
                                    <ComboBox x:Name="RestoreProfileCombo"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Créer d'abord le compte du client et l'ouvrir une fois. Restaurer de préférence depuis sa session."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="À restaurer" Style="{StaticResource SectionTitle}"/>
                                    <StackPanel x:Name="RestoreItems"/>
                                    <Expander x:Name="AppsExpander" Header="Choisir les applications à réinstaller" Margin="24,0,0,0" Visibility="Collapsed">
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Margin="0,0,0,4">
                                                <Hyperlink Click="CheckAllApps_Click">Tout cocher</Hyperlink>
                                                <Run Text="   "/>
                                                <Hyperlink Click="UncheckAllApps_Click">Tout décocher</Hyperlink>
                                            </TextBlock>
                                            <WrapPanel x:Name="AppList"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border x:Name="RestorePasswordCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Mot de passe de la sauvegarde" Style="{StaticResource SectionTitle}"/>
                                    <PasswordBox x:Name="RestorePassword" Padding="4,3"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Celui choisi lors de la sauvegarde : il déchiffre les mots de passe et les clés Wi-Fi."/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="▶  Lancer la restauration" Padding="14,9"
                                    HorizontalAlignment="Left" Click="RestoreButton_Click" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Journal -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                    <Button x:Name="ReportButton" Content="Rapport de migration" Padding="10,4" Click="ReportButton_Click"
                            ToolTip="Fiche client « ce qui a été transféré » (HTML, PDF ou texte)"/>
                    <Button x:Name="StopButton" Content="Arrêter après l'étape" Padding="10,4" Margin="8,0,0,0" IsEnabled="False" Click="StopButton_Click"/>
                    <Button Content="Copier le journal" Padding="10,4" Margin="8,0,0,0" Click="CopyLog_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Padding="8"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
