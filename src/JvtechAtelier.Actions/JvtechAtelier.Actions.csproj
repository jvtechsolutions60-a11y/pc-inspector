<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Seul module de JVTECH v2 autorisé à modifier Windows (mises à jour, logiciels, pilotes, test mémoire, Sysprep
    confirmé). Utilisé uniquement par JVTECH Atelier, qui compile ses fichiers dans son .exe.
    JVTECH Audit ne doit jamais l'inclure : tests/JvtechTests/SeparationTests le vérifie.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>JvtechAtelier.Actions</AssemblyName>
    <RootNamespace>Jvtech.Atelier.Actions</RootNamespace>
    <Product>JVTECH Atelier, actions</Product>
    <Company>JVTECH Solutions</Company>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PcInspector\Polyfills.cs" Link="Shared\Polyfills.cs" />
    <!-- Repris de PC Inspector et PC Maintenance, tels quels : Windows Update (agent COM) et winget -->
    <Compile Include="..\PcInspector\WindowsState.cs" Link="Shared\WindowsState.cs" />
    <Compile Include="..\PcInspector\WingetShell.cs" Link="Shared\WingetShell.cs" />
    <Compile Include="..\PcMaintenance\Maintenance\WindowsUpdate.cs" Link="Shared\WindowsUpdate.cs" />
    <Compile Include="..\PcMaintenance\Maintenance\Winget.cs" Link="Shared\Winget.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- Les actions s'appuient sur la bibliothèque en lecture seule (jamais l'inverse) -->
  <ItemGroup>
    <ProjectReference Include="..\JvtechLecture\JvtechLecture.csproj" />
  </ItemGroup>

</Project>
