<Window x:Class="JvtechServeur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Serveur PXE" Height="760" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Content="Accepter les PC (30 min)" Click="AcceptButton_Click" Margin="0,0,10,0"
                            ToolTip="Pendant 30 minutes, tout PC démarré sur le réseau (F12) est effacé et réinstallé"/>
                    <Button x:Name="ServerButton" Style="{StaticResource DarkButton}" Content="Démarrer le serveur" Click="ServerButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="JVTECH · SERVEUR PXE · PRÉPARATION REVENTE" Style="{StaticResource AppSubtitle}" FontWeight="SemiBold" Margin="0"/>
                    <TextBlock x:Name="StatusText" Text="Serveur arrêté" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AcceptText" Foreground="{StaticResource HeaderMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Les PC ne sont pas acceptés : aucun PC ne peut être effacé par erreur."/>
                    <WrapPanel x:Name="StatsPanel" Margin="0,10,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Nouvelle mise à jour de Windows à intégrer -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="{StaticResource UpdateBrush}" Padding="28,10" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Intégrer maintenant" Padding="12,4" Click="ApplyUpdate_Click"/>
                <TextBlock x:Name="UpdateText" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Image Windows 11" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ImageText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="ImageHint" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                            <Button x:Name="PrepareButton" Content="Préparer depuis une ISO…" Padding="10,5" Click="Prepare_Click" Margin="0,0,0,6"
                                    ToolTip="ISO officielle de Windows 11 (site Microsoft ou outil de création de média)"/>
                            <Button x:Name="CheckButton" Content="Chercher la mise à jour du mois" Padding="10,5" Click="Check_Click"/>
                            <CheckBox x:Name="AutoUpdateBox" Content="L'intégrer toute seule quand aucun PC n'est en cours" Margin="0,10,0,0"
                                      Foreground="{StaticResource TextBrush}" Click="AutoUpdate_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Réseau de l'atelier" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="AddressBox" DisplayMemberPath="Label" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"
                                       Text="Carte réseau reliée aux PC à préparer. La box garde son rôle (adresses IP) : le serveur n'indique aux PC que où démarrer."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Préparer un PC" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" xml:space="preserve">1. Brancher le PC au réseau par câble et sur secteur.
2. Cliquer sur « Accepter les PC ».
3. Allumer le PC et appuyer sur F12 (Dell, Lenovo), F9 (HP) ou Échap, puis choisir le démarrage réseau (IPv4).
4. Tout est automatique ensuite : effacement, Windows 11, mises à jour, pilotes, BIOS, nettoyage. Le PC s'éteint quand il est prêt pour son acheteur.</TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Dossier des rapports" Padding="10,4" Margin="0,0,6,0" Click="Reports_Click"/>
                            <Button Content="Retirer les terminés" Padding="10,4" Click="ClearFinished_Click"/>
                        </StackPanel>
                        <TextBlock Text="PC en préparation" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Aucun PC pour le moment. Ils apparaissent ici dès leur démarrage réseau."/>
                        <ListBox x:Name="PosteList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding State}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Duration}" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                                                <Button Content="Rapport" Padding="8,2" Margin="0,4,0,0" Click="OpenReport_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Step}" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Copier le journal" Padding="10,4" Click="CopyLog_Click"/>
                        <TextBlock Text="Journal" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Padding="8"/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
