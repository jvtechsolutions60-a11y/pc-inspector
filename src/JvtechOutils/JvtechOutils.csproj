<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Comme les trois logiciels : .NET Framework 4.8, déjà présent sur Windows 10 et 11 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>JvtechOutils</AssemblyName>
    <RootNamespace>JvtechOutils</RootNamespace>
    <Product>JVTECH Outils</Product>
    <Company>JVTECH Solutions</Company>
    <Version>1.0.0</Version>
    <!-- Même style d'icône pour tous les logiciels JVTECH, une couleur par logiciel -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Version, dossiers (mode clé USB) et vérification des mises à jour, partagés avec les trois logiciels -->
  <ItemGroup>
    <Compile Include="..\PcInspector\Polyfills.cs" Link="Shared\Polyfills.cs" />
    <Page Include="..\PcInspector\Theme.xaml" Link="Theme.xaml" />
    <Compile Include="..\PcInspector\AppInfo.cs" Link="Shared\AppInfo.cs" />
    <Compile Include="..\PcInspector\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
    <Compile Include="..\PcInspector\Updater.cs" Link="Shared\Updater.cs" />
  </ItemGroup>

  <!-- Icônes des logiciels, affichées sur leurs boutons -->
  <ItemGroup>
    <Resource Include="..\PcInspector\app.ico" Link="Icons\PcInspector.ico" />
    <Resource Include="..\PcSecurite\app.ico" Link="Icons\PcSecurite.ico" />
    <Resource Include="..\PcMaintenance\app.ico" Link="Icons\PcMaintenance.ico" />
    <Resource Include="..\PcMigration\app.ico" Link="Icons\PcMigration.ico" />
  </ItemGroup>

</Project>
