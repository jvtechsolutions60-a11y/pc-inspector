<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 est fourni avec Windows 10 et 11 : exe de quelques centaines de Ko, rien à installer -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>PcInspector</AssemblyName>
    <RootNamespace>PcInspector</RootNamespace>
    <Product>PC Inspector</Product>
    <Company>JVTECH Solutions</Company>
    <Version>1.0.0</Version>
    <!-- Même style d'icône pour tous les logiciels JVTECH, une couleur par logiciel -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Printing" />
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- 7-Zip 26.06 (7zr.exe, LGPL, github.com/ip7z/7zip) : test du processeur de l'onglet Performances -->
    <EmbeddedResource Include="Tools\7zr.exe" LogicalName="7zr.exe" />
  </ItemGroup>

  <!-- Les tests automatisés (tests/JvtechTests) vérifient les règles internes sans rien exécuter sur le PC. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JvtechTests" />
  </ItemGroup>

</Project>
