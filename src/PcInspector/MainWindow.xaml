<Window x:Class="PcInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcInspector"
        Title="PC Inspector" Height="760" Width="1060" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:HasValueConverter x:Key="HasValue"/>
        <local:StatusBrushConverter x:Key="StatusBrush"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale : onglets classés Matériel / Diagnostic / Logiciel -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                <TextBlock Text="PC INSPECTOR" Style="{StaticResource AppName}"/>
                <TextBlock Text="Analyse complète du PC" Style="{StaticResource AppSubtitle}"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                <TextBlock x:Name="UpdateNotice" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed">
                    <Hyperlink x:Name="UpdateLink" Foreground="{StaticResource UpdateBrush}" Click="UpdateLink_Click">
                        <Run x:Name="UpdateText"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="PortableText" Text="Mode clé USB : rien n'est enregistré sur ce PC" Foreground="{StaticResource HeaderTextBrush}"
                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" x:Name="ExportButton" Style="{StaticResource PrimaryButton}"
                    Content="Exporter le rapport" Margin="16" Click="ExportButton_Click"
                    ToolTip="Rapport client complet (HTML, PDF ou texte) avec ton logo"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,0">
                <TextBlock Text="OUTILS" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="4,0,0,6"/>
                <Button Style="{StaticResource DarkButton}" Content="Tester les périphériques" Margin="0,0,0,6" Click="PeripheralTest_Click"
                        ToolTip="Écran, clavier, haut-parleurs, micro, webcam"/>
                <Button Style="{StaticResource DarkButton}" Content="Suivi en direct" Margin="0,0,0,6" Click="LiveMonitor_Click"
                        ToolTip="Charge et températures en courbes, pendant un test"/>
                <Button Style="{StaticResource DarkButton}" Content="Étiquette PC" Click="Label_Click"
                        ToolTip="Petite fiche à coller sous le PC : config, date, coordonnées"/>
            </StackPanel>
            <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="SectionList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#64748B" FontSize="11" FontWeight="Bold"
                                           Margin="20,14,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bd" Background="Transparent" Margin="8,1" CornerRadius="6" Padding="12,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="8,6" CornerRadius="2"
                                                Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Écran d'accueil : bilan en 1 clic -->
        <DockPanel Grid.Column="1" x:Name="HealthPanel" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ScoreBadge" Width="96" Height="96" CornerRadius="48" Background="{StaticResource InfoBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreText" Text="…" FontSize="34" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/ 100" Foreground="White" Opacity="0.85" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictText" Text="Bilan en cours…" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CountsText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="HealthExportButton" Style="{StaticResource PrimaryButton}" Content="Exporter le rapport client"
                                Click="ExportButton_Click"/>
                        <Button x:Name="HealthRefreshButton" Content="Relancer le bilan" Margin="0,8,0,0"
                                Click="HealthRefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top" x:Name="HealthStatus" Foreground="{StaticResource MutedTextBrush}"
                       Margin="28,12,28,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,8">
                <ItemsControl x:Name="FindingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="0,0,0,8"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Bar" CornerRadius="8,0,0,8" Background="{StaticResource OkBrush}"/>
                                    <TextBlock x:Name="Mark" Grid.Column="1" Text="{Binding Mark}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Margin="0,10">
                                        <TextBlock Text="{Binding Area}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource LinkButton}" Content="Voir le détail"
                                            Tag="{Binding Tab}" Click="FindingDetail_Click" Margin="12,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource CriticalBrush}"/>
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarningBrush}"/>
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Contenu de l'onglet sélectionné -->
        <DockPanel Grid.Column="1" x:Name="DetailPanel">
            <!-- En-tête de l'onglet : titre, recherche, actions -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="220" Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox" Padding="28,6,8,6" VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource ControlBorderBrush}" TextChanged="SearchBox_TextChanged"
                                     ToolTip="Filtrer les lignes de cet onglet (Ctrl+F)"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="Rechercher…" Foreground="#94A3B8" Margin="30,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="CopyButton" Content="Copier" Margin="0,0,8,0" Click="CopyButton_Click"
                                ToolTip="Copier cet onglet en texte (pour un devis, un e-mail…)"/>
                        <Button x:Name="RefreshButton" Content="⟳" Click="RefreshButton_Click" ToolTip="Relire cet onglet (F5)"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar x:Name="LoadingBar" DockPanel.Dock="Top" Height="3" IsIndeterminate="True" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,8">
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="18,14" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"
                                                                   TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0"
                                                                 Foreground="{Binding Value, Converter={StaticResource StatusBrush}, FallbackValue={StaticResource TextBrush}}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Grid.Column="1">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate"
                                                                       Foreground="{StaticResource AccentBrush}">
                                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
