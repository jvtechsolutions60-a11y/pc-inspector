<Window x:Class="PcInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcInspector"
        Title="PC Inspector" Height="720" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}">
    <Window.Resources>
        <local:HasValueConverter x:Key="HasValue"/>
        <local:StatusBrushConverter x:Key="StatusBrush"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale : un onglet par composant -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <TextBlock DockPanel.Dock="Top" Text="PC Inspector" Foreground="White"
                       FontSize="18" FontWeight="SemiBold" Margin="18,18,18,14"/>
            <Button DockPanel.Dock="Bottom" x:Name="ExportButton" Content="Exporter le rapport"
                    Margin="14" Padding="8,6" Click="ExportButton_Click"/>
            <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="SectionList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#D1D5DB"/>
                        <Setter Property="Padding" Value="18,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Écran d'accueil : bilan en 1 clic -->
        <DockPanel Grid.Column="1" x:Name="HealthPanel" Margin="28,20,20,20" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,14"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ScoreBadge" Width="96" Height="96" CornerRadius="48" Background="#9CA3AF">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScoreText" Text="…" FontSize="34" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/ 100" Foreground="White" Opacity="0.85" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictText" Text="Bilan en cours…" FontSize="22" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CountsText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="HealthExportButton" Content="Exporter le rapport client" Padding="16,8"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Click="ExportButton_Click"/>
                        <Button x:Name="RefreshButton" Content="Relancer le bilan" Padding="16,6" Margin="0,8,0,0"
                                Click="RefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock DockPanel.Dock="Top" x:Name="HealthStatus" Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FindingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Bar" CornerRadius="6,0,0,6" Background="{StaticResource OkBrush}"/>
                                    <TextBlock x:Name="Mark" Grid.Column="1" Text="{Binding Mark}" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Margin="0,10">
                                        <TextBlock Text="{Binding Area}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Voir le détail" Tag="{Binding Tab}" Click="FindingDetail_Click"
                                            Margin="12,0" Padding="10,4" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource CriticalBrush}"/>
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarningBrush}"/>
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Contenu de l'onglet sélectionné -->
        <DockPanel Grid.Column="1" x:Name="DetailPanel" Margin="28,20,20,20">
            <TextBlock DockPanel.Dock="Top" x:Name="SectionTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock DockPanel.Dock="Top" x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,8" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="16,12" Margin="0,0,0,12"
                                    BorderBrush="#E5E7EB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                                             Foreground="{Binding Value, Converter={StaticResource StatusBrush}}"
                                                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock Grid.Column="1" Margin="2,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Url, Converter={StaticResource HasValue}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
