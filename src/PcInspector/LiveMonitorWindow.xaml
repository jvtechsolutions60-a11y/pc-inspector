<Window x:Class="PcInspector.LiveMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi en direct" Height="640" Width="760" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="PC INSPECTOR · OUTILS" Style="{StaticResource AppSubtitle}" FontWeight="SemiBold" Margin="0"/>
                <TextBlock Text="Suivi en direct" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Foreground="{StaticResource HeaderMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Charge et températures toutes les 2 secondes, sur les 5 dernières minutes. Laisser ouvert pendant un test, un jeu ou une vidéo pour repérer une surchauffe."/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel x:Name="Charts"/>
        </ScrollViewer>
    </DockPanel>
</Window>
