<Application x:Class="PcInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#1F2430"/>
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2E3546"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D8BFD"/>
        <SolidColorBrush x:Key="ContentBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280"/>
        <!-- Couleurs du bilan : rouge = à traiter, orange = à surveiller, vert = OK -->
        <SolidColorBrush x:Key="CriticalBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="OkBrush" Color="#16A34A"/>
    </Application.Resources>
</Application>
