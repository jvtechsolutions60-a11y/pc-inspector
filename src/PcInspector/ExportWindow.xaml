<Window x:Class="PcInspector.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporter le rapport" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource ContentBrush}" FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Margin="16" Padding="18,16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="IntroText"
                   Text="Société, technicien, contact et logo sont mémorisés. Le rapport est proposé dans le dossier du client."
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Société" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CompanyBox" Margin="0,4"/>

        <TextBlock Grid.Row="2" Text="Technicien" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TechnicianBox" Margin="0,4"/>

        <TextBlock Grid.Row="3" Text="Contact" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ContactBox" Margin="0,4"
                 ToolTip="Téléphone, e-mail ou site : repris sur le rapport et l'étiquette"/>

        <TextBlock Grid.Row="4" Text="Logo" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="LogoBox" Margin="0,4" IsReadOnly="True"/>
        <Button Grid.Row="4" Grid.Column="2" Content="Parcourir…" Margin="6,4,0,4" Padding="10,4" Click="BrowseLogo_Click"/>

        <TextBlock Grid.Row="5" Text="Client" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ClientBox" Margin="0,4"/>

        <TextBlock Grid.Row="6" Text="N° d'intervention" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="JobBox" Margin="0,4"/>

        <TextBlock Grid.Row="7" Text="Notes" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NotesBox" Margin="0,4"
                 Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Exporter…" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
