<Window x:Class="PcInspector.ListingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texte d'annonce" Height="720" Width="1000" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="PC INSPECTOR · OUTILS" Style="{StaticResource AppSubtitle}" FontWeight="SemiBold" Margin="0"/>
                <TextBlock Text="Texte d'annonce" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <TextBlock Foreground="{StaticResource HeaderMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Les composants sont relevés automatiquement. Compléter ce que le logiciel ne peut pas lire, puis copier le titre et le descriptif dans Leboncoin ou Shopify, ou enregistrer la fiche technique en PDF."/>
            </StackPanel>
        </Border>
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="À compléter à la main" Style="{StaticResource CardTitle}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Aucun logiciel ne peut lire le boîtier, l'alimentation ni le ventirad. Laisser vide ce qui ne sert pas (portable)."/>
                    <TextBlock Text="Boîtier" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="CaseBox" Margin="0,2,0,8" TextChanged="Field_Changed" ToolTip="Ex. : Corsair 4000D Airflow, noir, vitre trempée"/>
                    <TextBlock Text="Alimentation" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="PsuBox" Margin="0,2,0,8" TextChanged="Field_Changed" ToolTip="Ex. : be quiet! Pure Power 12 M 650 W 80+ Gold"/>
                    <TextBlock Text="Refroidissement" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="CoolerBox" Margin="0,2,0,8" TextChanged="Field_Changed" ToolTip="Ex. : ventirad Noctua NH-U12S, 3 ventilateurs"/>
                    <TextBlock Text="État" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox x:Name="ConditionBox" IsEditable="True" Margin="0,2,0,8"
                              TextBoxBase.TextChanged="Field_Changed" SelectionChanged="Condition_Changed">
                        <ComboBoxItem Content="Très bon état, aucune trace d'usage"/>
                        <ComboBoxItem Content="Bon état, légères traces d'usage"/>
                        <ComboBoxItem Content="État correct, traces d'usage visibles"/>
                    </ComboBox>
                    <TextBlock Text="Remarques (garantie, accessoires, livraison…)" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="NotesBox" Height="110" Margin="0,2,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" TextChanged="Field_Changed"
                             ToolTip="Gardé pour la prochaine annonce"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copier" Margin="8,0,0,0" Click="CopyTitle_Click" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="Titre" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="TitleBox" FontSize="14" TextChanged="Title_Changed"/>
                            <TextBlock x:Name="TitleLength" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Copier le descriptif" Click="CopyDescription_Click"/>
                    <Button DockPanel.Dock="Right" Content="Fiche technique PDF" Margin="0,0,8,0" Click="Pdf_Click"
                            ToolTip="Fiche A4 avec ton logo, à joindre aux photos de l'annonce ou à remettre à l'acheteur"/>
                    <Button DockPanel.Dock="Right" Content="Relire les composants" Margin="0,0,8,0" Click="Reload_Click"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Descriptif (modifiable avant de copier)" Style="{StaticResource CardTitle}"/>
                        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Segoe UI" FontSize="13" BorderThickness="0"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
