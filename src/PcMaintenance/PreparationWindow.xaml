<Window x:Class="PcMaintenance.PreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparation revente" Height="720" Width="900" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <DockPanel>
                <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource DarkButton}" VerticalAlignment="Center"
                        Content="Arrêter la préparation" Click="StopButton_Click"
                        ToolTip="S'arrête à la fin de l'étape en cours et ne se relance plus au démarrage"/>
                <StackPanel>
                    <TextBlock Text="PC MAINTENANCE · PRÉPARATION REVENTE" Style="{StaticResource AppSubtitle}" FontWeight="SemiBold" Margin="0"/>
                    <TextBlock x:Name="StatusText" Text="Démarrage…" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SinceText" Foreground="{StaticResource HeaderMutedBrush}" Margin="0,4,0,0"/>
                    <ProgressBar x:Name="Busy" Height="6" Margin="0,12,0,0" MaxWidth="520" HorizontalAlignment="Stretch" IsIndeterminate="True"
                                 Background="#334155" BorderThickness="0" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Étapes : la préparation reprend toute seule après chaque redémarrage -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Étapes" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Foreground="{Binding Brush}" FontSize="15" Width="24"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextBrush}" FontWeight="{Binding Weight}"/>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,12,0,0"
                               Text="Le PC redémarre plusieurs fois et reprend tout seul. À la fin, il s'éteint, prêt pour son acheteur."/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Copier le journal" Padding="10,4" Click="CopyLog_Click"/>
                    <TextBlock Text="Journal" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Padding="8"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
