<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Même choix que PC Inspector : .NET Framework 4.8, déjà présent sur Windows 10 et 11 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>PcMaintenance</AssemblyName>
    <RootNamespace>PcMaintenance</RootNamespace>
    <Product>PC Maintenance</Product>
    <Company>JVTECH Solutions</Company>
    <Version>1.0.0</Version>
    <!-- Même style d'icône pour tous les logiciels JVTECH, une couleur par logiciel -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Printing" />
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <!-- PCMAINTENANCE : retire du texte d'annonce la ligne des performances (tests de PC Inspector, absents ici). -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PCMAINTENANCE</DefineConstants>
  </PropertyGroup>

  <!-- Code partagé avec PC Inspector : version, dossiers (mode clé USB), mises à jour, rapport client et fenêtre d'export -->
  <ItemGroup>
    <Compile Include="..\PcInspector\Polyfills.cs" Link="Shared\Polyfills.cs" />
    <Page Include="..\PcInspector\Theme.xaml" Link="Theme.xaml" />
    <Compile Include="..\PcInspector\AppInfo.cs" Link="Shared\AppInfo.cs" />
    <Compile Include="..\PcInspector\WindowsState.cs" Link="Shared\WindowsState.cs" />
    <Compile Include="..\PcInspector\ProcessRunner.cs" Link="Shared\ProcessRunner.cs" />
    <Compile Include="..\PcInspector\WingetShell.cs" Link="Shared\WingetShell.cs" />
    <Compile Include="..\PcInspector\Authenticode.cs" Link="Shared\Authenticode.cs" />
    <Compile Include="..\PcInspector\WindowsUpdateFailures.cs" Link="Shared\WindowsUpdateFailures.cs" />
    <Compile Include="..\PcInspector\CrashGuard.cs" Link="Shared\CrashGuard.cs" />
    <Compile Include="..\PcInspector\Updater.cs" Link="Shared\Updater.cs" />
    <Compile Include="..\PcInspector\Models\InfoSection.cs" Link="Shared\InfoSection.cs" />
    <Compile Include="..\PcInspector\Report\ReportInfo.cs" Link="Shared\ReportInfo.cs" />
    <Compile Include="..\PcInspector\Report\ReportWriter.cs" Link="Shared\ReportWriter.cs" />
    <Compile Include="..\PcInspector\Report\PdfPrinter.cs" Link="Shared\PdfPrinter.cs" />
    <Page Include="..\PcInspector\ExportWindow.xaml" Link="ExportWindow.xaml" />
    <Compile Include="..\PcInspector\ExportWindow.xaml.cs" Link="ExportWindow.xaml.cs" DependentUpon="ExportWindow.xaml" />
  </ItemGroup>

  <!-- Étiquette à imprimer et texte Leboncoin, repris de PC Inspector (lecture seule des composants) -->
  <ItemGroup>
    <Compile Include="..\PcInspector\Collectors\Wmi.cs" Link="Shared\Wmi.cs" />
    <Compile Include="..\PcInspector\Collectors\MachineIdentity.cs" Link="Shared\MachineIdentity.cs" />
    <Compile Include="..\PcInspector\Collectors\ICollector.cs" Link="Shared\ICollector.cs" />
    <Compile Include="..\PcInspector\Collectors\GpuCollector.cs" Link="Shared\GpuCollector.cs" />
    <Compile Include="..\PcInspector\Collectors\GpuDriver.cs" Link="Shared\GpuDriver.cs" />
    <Compile Include="..\PcInspector\Collectors\BatteryCollector.cs" Link="Shared\BatteryCollector.cs" />
    <Compile Include="..\PcInspector\Models\Health.cs" Link="Shared\Health.cs" />
    <Compile Include="..\PcInspector\Report\LabelWriter.cs" Link="Shared\LabelWriter.cs" />
    <Compile Include="..\PcInspector\Report\LabelPrinter.cs" Link="Shared\LabelPrinter.cs" />
    <Compile Include="..\PcInspector\Report\ListingWriter.cs" Link="Shared\ListingWriter.cs" />
    <Page Include="..\PcInspector\ListingWindow.xaml" Link="ListingWindow.xaml" />
    <Compile Include="..\PcInspector\ListingWindow.xaml.cs" Link="ListingWindow.xaml.cs" DependentUpon="ListingWindow.xaml" />
  </ItemGroup>

  <!-- Les tests automatisés (tests/JvtechTests) vérifient les règles internes sans rien exécuter sur le PC. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JvtechTests" />
  </ItemGroup>

  <!-- Empreinte des scripts de Win11Debloat (audit I09), passée par la CI : -p:Win11DebloatSha256=... -->
  <ItemGroup>
    <AssemblyMetadata Include="Win11DebloatSha256" Value="$(Win11DebloatSha256)" />
  </ItemGroup>
</Project>
