<Application x:Class="PcMaintenance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Charte commune aux logiciels JVTECH (src/PcInspector/Theme.xaml) -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Cartes du résumé, côte à côte -->
            <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="Padding" Value="14,10"/>
            </Style>

            <!-- Texte sous chaque étape -->
            <Style x:Key="StepStatus" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Margin" Value="26,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
