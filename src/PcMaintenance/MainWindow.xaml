<Window x:Class="PcMaintenance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Maintenance" Height="880" Width="980" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="22,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock x:Name="ComputerText" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="RefreshButton" Content="Relancer l'analyse" Padding="12,5" Click="RefreshButton_Click"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PC Maintenance" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                        <TextBlock x:Name="PortableText" Text="Mode clé USB" Foreground="#93C5FD" FontSize="12" VerticalAlignment="Bottom"
                                   Margin="10,0,0,3" Visibility="Collapsed"/>
                        <TextBlock VerticalAlignment="Bottom" Margin="10,0,0,3" FontSize="12">
                            <Hyperlink x:Name="UpdateLink" Foreground="#FBBF24" Click="UpdateLink_Click"><Run x:Name="UpdateText"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Point de restauration, AdwCleaner, Glary, mises à jour Windows et logiciels, en une seule fois" Foreground="#9CA3AF"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Résumé rapide -->
            <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,-10,16">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Windows 11" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="Win11Value" Text="…" Style="{StaticResource CardValue}"/>
                        <TextBlock x:Name="Win11Detail" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Activation (slmgr /xpr)" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="ActivationValue" Text="…" Style="{StaticResource CardValue}"/>
                        <TextBlock x:Name="ActivationDetail" Text="Lecture en cours…" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mises à jour Windows" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="WuValue" Text="…" Style="{StaticResource CardValue}"/>
                        <TextBlock x:Name="WuDetail" Text="Recherche en cours…" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Logiciels (winget)" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="WingetValue" Text="…" Style="{StaticResource CardValue}"/>
                        <TextBlock x:Name="WingetDetail" Text="Recherche en cours…" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Glary Utilities" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="GlaryValue" Text="…" Style="{StaticResource CardValue}"/>
                        <TextBlock x:Name="GlaryDetail" Style="{StaticResource CardDetail}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Étapes de la maintenance -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button x:Name="StartButton" Content="Lancer la maintenance" Padding="14,8" FontWeight="SemiBold"
                                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="StartButton_Click"/>
                        <Button x:Name="StopButton" Content="Arrêter après l'étape" Padding="14,6" Margin="0,8,0,0"
                                IsEnabled="False" Click="StopButton_Click"/>
                        <Button Content="Ouvrir Windows Update" Padding="14,6" Margin="0,8,0,0" Click="OpenWindowsUpdate_Click"/>
                        <Button x:Name="ReportButton" Content="Rapport de maintenance" Padding="14,6" Margin="0,8,0,0"
                                Click="ReportButton_Click" ToolTip="Fiche client de ce qui a été fait (HTML, PDF ou texte)"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Étapes" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="RestoreCheck" IsChecked="True" FontSize="14"
                                  Content="1. Créer un point de restauration"/>
                        <TextBlock x:Name="RestoreStatus" Style="{StaticResource StepStatus}"
                                   Text="Pour pouvoir revenir en arrière si une étape pose problème."/>

                        <CheckBox x:Name="AdwCheck" IsChecked="True" FontSize="14" Margin="0,10,0,0"
                                  Content="2. Supprimer les adwares avec AdwCleaner"/>
                        <TextBlock x:Name="AdwStatus" Style="{StaticResource StepStatus}"
                                   Text="Dernière version téléchargée chez Malwarebytes, nettoyage automatique, sans redémarrer."/>

                        <CheckBox x:Name="GlaryCheck" IsChecked="True" FontSize="14" Margin="0,10,0,0"
                                  Content="3. Maintenance 1 clic de Glary Utilities"/>
                        <TextBlock x:Name="GlaryStatus" Style="{StaticResource StepStatus}"
                                   Text="La suite démarre quand la fenêtre de Glary est fermée."/>
                        <Button x:Name="InstallGlaryButton" Content="Installer Glary Utilities (winget)" Visibility="Collapsed"
                                HorizontalAlignment="Left" Margin="24,6,0,0" Padding="10,3" Click="InstallGlary_Click"/>

                        <CheckBox x:Name="WuCheck" IsChecked="True" FontSize="14" Margin="0,10,0,0"
                                  Content="4. Rechercher et installer les mises à jour Windows"/>
                        <TextBlock x:Name="WuStatus" Style="{StaticResource StepStatus}"
                                   Text="Téléchargement et installation une par une, sans redémarrer le PC."/>

                        <CheckBox x:Name="WingetCheck" IsChecked="True" FontSize="14" Margin="0,10,0,0"
                                  Content="5. Mettre à jour les logiciels (winget upgrade --all)"/>
                        <TextBlock x:Name="WingetStatus" Style="{StaticResource StepStatus}"
                                   Text="Installation silencieuse : fermer les logiciels ouverts avant de lancer."/>

                        <CheckBox x:Name="PackCheck" IsChecked="False" FontSize="14" Margin="0,10,0,0"
                                  Content="6. Installer le pack logiciels nouveau PC"/>
                        <TextBlock x:Name="PackStatus" Style="{StaticResource StepStatus}"
                                   Text="Les logiciels cochés ci-dessous, installés avec winget (déjà installés : ignorés)."/>
                        <Expander Header="Choisir les logiciels" Margin="24,4,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <WrapPanel x:Name="PackList"/>
                                <TextBlock Margin="0,4,0,0">
                                    <Hyperlink Click="EditPack_Click">Modifier la liste (pack.ini)</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Journal -->
            <DockPanel Grid.Row="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Copier le journal" Padding="10,3" Click="CopyLog_Click"/>
                    <TextBlock Text="Journal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="White" BorderBrush="#E5E7EB" Padding="6"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
