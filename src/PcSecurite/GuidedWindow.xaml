<Window x:Class="PcSecurite.GuidedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mode guidé" Height="600" Width="680" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ContentBrush}">
    <DockPanel Margin="24,20">
        <!-- Position dans la liste -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="PositionText" Foreground="{StaticResource MutedTextBrush}"/>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>

        <!-- Navigation -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Content="◀ Précédent" Padding="12,6" Click="PreviousButton_Click"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="Suivant ▶" Padding="12,6" Click="NextButton_Click"/>
        </Grid>

        <!-- Le point en cours -->
        <Border Background="White" CornerRadius="6" Padding="18,14" BorderBrush="#E5E7EB" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="AdviceText" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="Comment faire" FontWeight="SemiBold" FontSize="15" Margin="0,16,0,6"/>
                    <TextBlock x:Name="StepsText" TextWrapping="Wrap" LineHeight="22"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="OpenButton" Padding="12,6" Margin="0,0,8,0" Click="OpenButton_Click"/>
                        <Button x:Name="CheckButton" Content="Vérifier" Padding="12,6" Click="CheckButton_Click"
                                ToolTip="Refait ce contrôle (lecture seule) une fois la correction faite"/>
                    </WrapPanel>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
