<Window x:Class="PcSecurite.GuidedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mode guidé" Height="640" Width="720" MinHeight="440" MinWidth="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI">
    <DockPanel>
        <!-- Position dans la liste -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="MODE GUIDÉ" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="PositionText" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" Background="#334155" BorderThickness="0"
                             Foreground="{StaticResource OkBrush}"/>
            </StackPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Suivant ▶" Click="NextButton_Click"/>
                <Button x:Name="PreviousButton" Content="◀ Précédent" HorizontalAlignment="Left" Click="PreviousButton_Click"/>
            </DockPanel>
        </Border>

        <!-- Le point en cours -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusStripe" CornerRadius="8,0,0,8"/>
                    <StackPanel Grid.Column="1" Margin="20,16">
                        <DockPanel>
                            <Border x:Name="StatusChip" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" VerticalAlignment="Top">
                                <TextBlock x:Name="StatusLabel" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,10,0"/>
                        </DockPanel>
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#334155"/>
                        <TextBlock x:Name="AdviceText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}"/>

                        <Border Background="#F8FAFC" CornerRadius="6" Padding="16,12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Comment faire" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="StepsText" TextWrapping="Wrap" LineHeight="23" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextBrush}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="OpenButton" Style="{StaticResource LinkButton}" Margin="0,0,8,0" Click="OpenButton_Click"/>
                                    <Button x:Name="CheckButton" Style="{StaticResource PrimaryButton}" Content="✓  Vérifier" Click="CheckButton_Click"
                                            ToolTip="Refait ce contrôle (lecture seule) une fois la correction faite"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ResultBorder" CornerRadius="6" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
