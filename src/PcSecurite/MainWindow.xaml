<Window x:Class="PcSecurite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PcSecurite"
        Title="PC Sécurité" Height="720" Width="860" MinHeight="460" MinWidth="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}">
    <Window.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush"/>
    </Window.Resources>
    <DockPanel Margin="24,20">
        <!-- En-tête : note globale -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ScoreCircle" Width="86" Height="86" CornerRadius="43" Background="{StaticResource InfoBrush}">
                <TextBlock x:Name="ScoreText" Text="…" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="PC Sécurité" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VerdictText" Text="Analyse en cours…" FontSize="15" Margin="0,4,0,0"/>
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="RescanButton" Content="Relancer l'analyse" Padding="12,6" Margin="0,0,0,8" Click="RescanButton_Click"/>
                <Button x:Name="ExportButton" Content="Exporter le rapport" Padding="12,6" Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Un contrôle par ligne -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CheckList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                                BorderBrush="#E5E7EB" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,0,0"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Advice}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Tutoriel pas à pas, replié par défaut -->
                                    <Expander Header="Comment faire ?" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tutorial}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <StackPanel Margin="20,6,0,0">
                                            <TextBlock Text="{Binding Tutorial.Text}" TextWrapping="Wrap" LineHeight="20"
                                                       Foreground="#1F2937"/>
                                            <Button Content="{Binding Tutorial.OpenLabel}" Tag="{Binding Tutorial}" Click="OpenSetting_Click"
                                                    HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tutorial.OpenLabel}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
