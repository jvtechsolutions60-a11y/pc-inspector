<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module optionnel de JVTECH Sonde : température précise du processeur avec LibreHardwareMonitor (licence MPL 2.0,
    github.com/LibreHardwareMonitor/LibreHardwareMonitor). Livré dans le sous-dossier « capteurs » de la sonde, avec
    ses dépendances. La sonde ne le charge que si le pilote PawnIO est déjà installé sur le PC : sans lui, rien de
    ce module n'est exécuté et la sonde garde la valeur ACPI. Seul projet JVTECH qui utilise un paquet NuGet,
    d'où ce module à part : JvtechSonde.exe reste un .exe seul, sans dépendance.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>JvtechSonde.Capteurs</AssemblyName>
    <RootNamespace>JvtechSonde.Capteurs</RootNamespace>
    <Product>JVTECH Sonde (capteurs)</Product>
    <Company>JVTECH Solutions</Company>
    <Version>1.0.0</Version>
    <!-- Les dépendances NuGet sont copiées à côté du module : le dossier « capteurs » se suffit à lui-même. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- LibreHardwareMonitor est livré par architecture : version 64 bits, celle de la sonde sur Windows 10 et 11 64 bits.
         Sur un Windows 32 bits, le module ne se charge pas et la sonde garde la valeur ACPI. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version figée : 0.9.6 lit le processeur par le pilote PawnIO (plus de WinRing0, signalé par Defender). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
