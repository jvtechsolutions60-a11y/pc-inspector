<Window x:Class="JvtechAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Audit" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RelancerButton" Content="Relancer l'audit" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                            Padding="12,6" Click="Relancer_Click" IsEnabled="False" ToolTip="Relit toutes les informations (rien n'est modifié)"/>
                    <Button x:Name="ExportButton" Content="Exporter le rapport…" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Click="Export_Click" IsEnabled="False" ToolTip="Synthèse client et annexe technicien, à l'endroit que vous choisissez"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="JVTECH AUDIT" Style="{StaticResource AppName}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="20,16" MaxWidth="1240">
                <!-- Identification et état de la collecte -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="420">
                            <TextBlock x:Name="CollecteText" Style="{StaticResource CardDetail}" TextAlignment="Right" Text="Collecte en cours…"/>
                            <TextBlock x:Name="DroitsText" Style="{StaticResource CardDetail}" TextAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="PcText" Style="{StaticResource PageTitle}" Text="Lecture du PC…" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PcDetailText" Style="{StaticResource CardDetail}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Synthèse : alertes prioritaires et recommandations -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,8">
                    <StackPanel>
                        <TextBlock x:Name="SyntheseText" Style="{StaticResource SectionTitle}" Text="Synthèse"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="Pas de note globale : un défaut grave reste toujours en tête."/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Alertes prioritaires" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel x:Name="AlertesPanel"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Recommandations" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <StackPanel x:Name="RecosPanel"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Les blocs du tableau de bord -->
                <WrapPanel x:Name="BlocsPanel"/>

                <!-- Limites -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,8" Background="#F8FAFC">
                    <StackPanel>
                        <TextBlock Text="Limites de cet audit" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel x:Name="LimitesPanel" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
