<Window x:Class="JvtechAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVTECH Audit" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ContentBrush}" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <StackPanel>
                <TextBlock Text="JVTECH AUDIT" Style="{StaticResource AppName}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource AppSubtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tableau de bord" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Version d'aperçu (lot 0) : la page d'accueil avec les 11 blocs arrive au lot 2. Cette version ne lit encore rien sur le PC et n'y écrit rien."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
